{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Nocturne",
  "author": "Nocturne",
  "themes": [
    {
      "name": "Nocturne",
      "appearance": "dark",
      "style": {
        "background": "#000000",
        "border": "#AEB1B8",
        "editor.background": "#000000",
        "editor.foreground": "#ffffff",
        "editor.line_number": "#626262",
        "editor.active_line_number": "#ffffff",
        "editor.active_line.background": "#121212",
        "editor.gutter.background": "#000000",
        "editor.indent_guide": "#626262",
        "editor.indent_guide_active": "#8E8E93",
        "status_bar.background": "#121212",
        "title_bar.background": "#121212",
        "toolbar.background": "#121212",
        "tab_bar.background": "#121212",
        "tab.active_background": "#000000",
        "tab.inactive_background": "#2C2C2E",
        "panel.background": "#2C2C2E",
        "surface.background": "#121212",
        "elevated_surface.background": "#2C2C2E",
        "element.background": "#2C2C2E",
        "element.hover": "#404040",
        "element.active": "#5c5c5c",
        "element.selected": "#5c5c5c",
        "text": "#ffffff",
        "text.muted": "#8E8E93",
        "text.disabled": "#626262",
        "text.accent": "#ffff00",
        "icon": "#ffffff",
        "icon.muted": "#8E8E93",
        "scrollbar.thumb.background": "#5c5c5c",
        "scrollbar.track.background": "#000000",
        "terminal.background": "#000000",
        "terminal.foreground": "#ffffff",
        "terminal.ansi.black": "#404040",
        "terminal.ansi.red": "#a4a4a4",
        "terminal.ansi.green": "#b6b6b6",
        "terminal.ansi.yellow": "#cecece",
        "terminal.ansi.blue": "#8d8d8d",
        "terminal.ansi.magenta": "#9b9b9b",
        "terminal.ansi.cyan": "#b0b0b0",
        "terminal.ansi.white": "#ececec",
        "terminal.ansi.bright_black": "#5c5c5c",
        "terminal.ansi.bright_red": "#a4a4a4",
        "terminal.ansi.bright_green": "#b6b6b6",
        "terminal.ansi.bright_yellow": "#cecece",
        "terminal.ansi.bright_blue": "#8d8d8d",
        "terminal.ansi.bright_magenta": "#9b9b9b",
        "terminal.ansi.bright_cyan": "#b0b0b0",
        "terminal.ansi.bright_white": "#ffffff",
        "syntax": {
          "comment": { "color": "#ffff00", "font_style": "italic" },
          "constant": { "color": "#ffffff" },
          "string": { "color": "#ffffff" },
          "number": { "color": "#00ffc4" },
          "boolean": { "color": "#00ffc4" },
          "float": { "color": "#00ffc4" },
          "function": { "color": "#ffffff" },
          "keyword": { "color": "#0080ff", "font_weight": 700 },
          "keyword.control": { "color": "#ff00c4" },
          "operator": { "color": "#ffc400" },
          "type": { "color": "#ffffff" },
          "macro": { "color": "#8000c4" },
          "special": { "color": "#00ffc4" },
          "property": { "color": "#0080ff" },
          "variable": { "color": "#ffffff" },
          "attribute": { "color": "#0080ff" },
          "label": { "color": "#0080ff" },
          "tag": { "color": "#0080ff" }
        }
      }
    }
  ]
}
